{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadImageTag",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters"
      ],
      "Resource": "arn:aws:ssm:us-east-1:{{ACCOUNT_ID}}:parameter/taskflow/prod/*"
    },
    {
      "Sid": "ReadDbSecret",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:us-east-1:{{ACCOUNT_ID}}:secret:taskflow/prod/db-*"
    }
  ]
}
